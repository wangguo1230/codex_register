{
  "name": "codex-register",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup --config tsup.config.ts",
    "build:server": "tsup --config tsup.server.config.ts && tsup --config tsup.workers.config.ts",
    "build:all": "npm run build:server && npm run build && npm --prefix web run build",
    "server": "node bundle/server.mjs",
    "start": "node bundle/index.cjs",
    "check": "node bundle/check-auth-quota.cjs",
    "check:cpa": "node bundle/check-auth-quota.cjs --cpa",
    "batch": "node bundle/batch-register.cjs"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "better-sqlite3": "^12.11.1",
    "chromium-bidi": "^15.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fetch-cookie": "^3.1.0",
    "imapflow": "^1.3.3",
    "jsqr": "^1.4.0",
    "pg": "^8.22.0",
    "playwright-core": "^1.59.1",
    "pngjs": "^7.0.0",
    "socks": "^2.8.7",
    "tough-cookie": "^5.1.1",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "@types/pngjs": "^6.0.5",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
